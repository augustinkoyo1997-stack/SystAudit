# Copy this file to the repository root as .env and replace the example values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=sysaudit
POSTGRES_USER=sysaudit
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local development prints messages in the server terminal. For Gmail SMTP tests,
# enable 2-Step Verification, create an App Password, then set these values in .env.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=SystAudit <your-address@gmail.com>

# Keep empty/zero until the merchant account and 30-day Premium price are configured.
FEDAPAY_API_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_PREMIUM_PRICE_XOF=0
FEDAPAY_PREMIUM_MAX_DEVICES=5
